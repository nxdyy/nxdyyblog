---
// 首页分页（迁移自 pagination.ejs，md 组件版）
interface Props {
  current: number;
  total: number;
}
const { current, total } = Astro.props;

function pageUrl(n: number): string {
  return n === 1 ? '/' : `/page/${n}/`;
}

// 简化的窗口逻辑：1 ... (current-1) current (current+1) ... total
const pages: (number | 'ellipsis-left' | 'ellipsis-right')[] = [];
if (total <= 7) {
  for (let i = 1; i <= total; i++) pages.push(i);
} else {
  pages.push(1);
  if (current > 3) pages.push('ellipsis-left');
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) pages.push(i);
  if (current < total - 2) pages.push('ellipsis-right');
  pages.push(total);
}
---

{
  total > 1 && (
    <nav class="pagination-container" aria-label="分页">
      {current > 1 && (
        <a href={pageUrl(current - 1)} title="上一页">
          <md-icon-button>
            <span class="material-symbols-outlined">chevron_left</span>
          </md-icon-button>
        </a>
      )}
      {pages.map((p) =>
        typeof p === 'number' ? (
          p === current ? (
            <md-filled-tonal-button disabled>{p}</md-filled-tonal-button>
          ) : (
            <md-text-button href={pageUrl(p)}>
              {p}
            </md-text-button>
          )
        ) : (
          <span class="pagination-ellipsis">…</span>
        )
      )}
      {current < total && (
        <a href={pageUrl(current + 1)} title="下一页">
          <md-icon-button>
            <span class="material-symbols-outlined">chevron_right</span>
          </md-icon-button>
        </a>
      )}
    </nav>
  )
}
