---
// 文章摘要卡片（迁移自 excerpt.ejs）
import { formatDate, getPostUrl, previewFor, stripMarkdown } from '../lib/utils';
import { theme } from '../config/theme';

interface Props {
  post: any;
  top?: boolean;
}
const { post, top = false } = Astro.props;
const url = getPostUrl(post);
const cover = previewFor(post.data.title, theme.default_preview);
const excerpt = stripMarkdown(post.body || '', 80);
---

<div class="excerpt-card article-body">
  {
    top && (
      <div class="excerpt-pin-badge">
        <span class="material-symbols-outlined">push_pin</span>
      </div>
    )
  }
  <div class="excerpt-inner">
    <div class="excerpt-cover">
      <a href={url}>
        <img src={cover} alt={post.data.title} loading="lazy" />
      </a>
    </div>
    <div class="excerpt-body">
      <h2 class="excerpt-title">
        <a href={url}>{post.data.title}</a>
      </h2>
      <div class="excerpt-meta">
        <span class="excerpt-date">
          <span class="material-symbols-outlined">calendar_today</span>
          {formatDate(post.data.date)}
        </span>
        {
          post.data.tags.length > 0 && (
            <span class="excerpt-tag">
              <span class="material-symbols-outlined">label</span>
              {post.data.tags.map((t: string, i: number) => (
                <>
                  <a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
                  {i < post.data.tags.length - 1 && ', '}
                </>
              ))}
            </span>
          )
        }
      </div>
      <div class="excerpt-content">{excerpt}</div>
      <div class="excerpt-actions">
        <a href={url} class="read-more-btn">
          <span class="material-symbols-outlined">arrow_forward</span>
          阅读全文
        </a>
      </div>
    </div>
  </div>
</div>
