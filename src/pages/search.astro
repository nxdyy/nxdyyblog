---
// 搜索页（Vue 应用）
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SearchApp from '../components/vue/SearchApp.vue';
import { SITE } from '../lib/utils';
---

<BaseLayout title="搜索">
  <div class="page-card" id="search-page-card">
    <Breadcrumb labels={['搜索']} homeTitle={SITE.title} />
    <div class="page-title">
      <h1>
        <span class="material-symbols-outlined">search</span>
        搜索
      </h1>
    </div>
    <SearchApp client:only="vue" />
  </div>
</BaseLayout>
