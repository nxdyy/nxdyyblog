---
// 404 页面
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 页面不存在" fluid>
  <div class="page-card notfound-page">
    <div class="notfound-code">404</div>
    <span class="material-symbols-outlined" style="font-size: 64px; color: var(--md-sys-color-outline)">
      error
    </span>
    <p>页面不存在或已被移动</p>
    <a href="/">
      <md-filled-button>
        <span class="material-symbols-outlined" slot="icon">home</span>
        返回首页
      </md-filled-button>
    </a>
  </div>
</BaseLayout>
